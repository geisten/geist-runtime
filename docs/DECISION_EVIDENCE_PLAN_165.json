  "latency": {
    "pairs": "5 warm-up pairs, then 30 measured pairs per cell, alternating RI/IR (reuse first on even pair indices); a cell split into several sections (one process each, at most ~30 min estimated) repeats the 5 warm-up pairs in every section, warm-up pairs are never measured, measured pair indices continue across sections",
    "reuse_side": "context open (render, tokenize, prefix prefill, snapshot) + batch 1 (first package) + batch 2 on the same handle (repeated package) + close (teardown); each timed",
    "independent_side": "Q x geistr_decision_score on the A handle (package = sum of per-question wall times)",
    "first_package": "reuse open + batch 1 wall time vs the independent package of the same pair",
    "repeated_package": "reuse batch 2 wall time vs the independent package of the same pair",
    "statistic": "ratio of paired means reuse/independent and its two-sided 95 % paired bootstrap interval, 10000 resamples, seed 14917 (tools/decision_evidence_165.py paired_ratio = #17's)",
    "gate": "per cell and per package kind: PASS upper < 1.0, FAIL lower > 1.0, else INCONCLUSIVE; any failed side in a measured pair makes that cell FAIL; no pooling across cells, no exclusions",
    "reported": "p50/p95/mean per side; component p50s (open/setup, preparation = render+tokenize, scoring = restore+suffix prefill+readout+copy under the engine lock, close); the API does not time restore, readout or copy separately, so they are reported inside scoring; model calls (setup prefill per context, one per question per batch); snapshot bytes; RSS; output stability (every batch bit-identical to the cell's control C)"
  },
  "overhead_gate": {
    "protocol": "#17's, unchanged: 5 warm-up pairs, 30 measured pairs, AB/BA alternating, ratio of paired means, 10000-resample paired bootstrap, seed 14917, PASS upper <= 1.02, FAIL lower > 1.02, else INCONCLUSIVE",
    "A": "geistr_decision_context_score_batch with one question: its scoring_ms (restore + suffix + readout under the engine lock, results copied)",
    "B": "geist_decision_score_from_prefix on a direct engine handle with its own prefix prepared from the same cached IDs (same capacity, chunk, FP32 KV), same suffix and candidate IDs, under the same engine lock, logits and probabilities copied",
    "workload": "T = 256, questions q01..q16 in turn, one per pair; both outputs must be bit-identical to the context's complete batch",
    "combinations": "gemma4 and bonsai2 x cpu_neon and metal",
    "decode": "not applicable (no generation is invented)"
  },
